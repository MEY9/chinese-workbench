# 依赖与构建产物(任意层级)
**/node_modules/
**/dist/
**/__pycache__/
*.pyc

# 本机数据(用户私有,绝不入库)
**/data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# 教材 PDF 不入源码仓库；正式安装包按发布约定内置教材
**/textbooks/*.pdf
**/resources/textbooks/*.pdf

# 密钥与临时文件
**/.key
**/.base
**/.env
*.log
.tmp-*/
D:/Temp/

# 本机回滚备份与独立公开版构建
chinese/primary/archive/before-*/
**/dist-public/
**/.env.*
!**/.env.example
