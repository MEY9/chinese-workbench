{
  "name": "yuwen-workbench",
  "version": "3.0.3",
  "description": "小学语文教师桌面工作台",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pdfjs-dist": "^3.11.174",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "type": "module",
  "productName": "语文工作台",
  "build": {
    "appId": "com.yuwen.workbench",
    "productName": "语文工作台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/textbooks",
        "to": "textbooks"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}